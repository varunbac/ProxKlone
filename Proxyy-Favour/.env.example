# Copy this file to .env and replace these values with your SMTP provider settings.
FAVOUR_SMTP_HOST=smtp.example.com
FAVOUR_SMTP_PORT=587
FAVOUR_SMTP_USER=your-sender@example.com
FAVOUR_SMTP_PASSWORD=replace-with-your-mail-provider-password
FAVOUR_SMTP_FROM=your-sender@example.com
FAVOUR_SMTP_STARTTLS=true
FAVOUR_SMTP_SSL=false
